# AutoCusto BR — Backend
# Renomeie para .env e preencha com seus valores reais
# NUNCA faça commit deste arquivo com dados reais

# Gemini (primário) — gratuito em aistudio.google.com/app/apikey
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Groq (fallback 1) — gratuito em console.groq.com
GROQ_API_KEY=gsk_SUA_CHAVE_AQUI

# OpenRouter (fallback 2) — gratuito em openrouter.ai
OPENROUTER_API_KEY=sk-or-SUA_CHAVE_AQUI

# URL do frontend autorizado (ex: https://autocusto-br.vercel.app)
# Use * apenas para testes locais
ALLOWED_ORIGIN=*

# ── MODELOS DA CASCATA (opcionais) ────────────────────────────────────────
# Se não definidos, o código usa os defaults abaixo. Trocar de modelo aqui
# evita alterar código quando um provedor depreciar o que está em uso.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Lista separada por vírgula, tentada em ordem. Só modelos gratuitos.
# 'openrouter/auto' é PAGO — acrescente ao fim desta lista apenas se quiser
# habilitar o roteador pago como última tentativa.
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free

# ── TEMPO LIMITE DA CASCATA (opcionais) ───────────────────────────────────
# REGRA: CASCATA_TIMEOUT_MS * 3 <= CASCATA_ORCAMENTO_MS, porque são três
# camadas. Se a conta não fecha, a primeira camada come o orçamento inteiro e
# as outras duas são puladas por falta de tempo.
#
# Os padrões antigos do código, 5000 e 8000, quebram essa regra e foram a causa
# do app cair com 502 em 100% das comparações, medido em 22/09/2026. Tinham
# sido calibrados para um teto de 10 s por função, que era o do Hobby sem Fluid
# Compute. Com Fluid Compute, ligado por padrão, o Hobby tem 300 s.
# Ver https://vercel.com/docs/functions/limitations

# Teto por chamada de IA, em milissegundos. Aborta uma camada que não responde.
CASCATA_TIMEOUT_MS=10000

# Orçamento total da requisição somando todas as tentativas. Precisa ficar
# abaixo do tempo máximo de função da hospedagem, senão ela mata o processo
# antes de o backend devolver o erro ao cliente. Conferir o teto real em
# Settings > Functions do projeto antes de subir este valor.
CASCATA_ORCAMENTO_MS=30000

# Porta local
PORT=3000
